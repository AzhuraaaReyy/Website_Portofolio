# ===== Serverless Proxy (Vercel) — UTAMA =====
# Set token di dashboard Vercel (Settings → Environment Variables),
# JANGAN commit ke repo. Fine-grained PAT: scope Public repositories (read-only).
GITHUB_TOKEN=ghp_placeholder_isi_buat_local

# ===== Fallback klien (KHUSUS DEVELOPMENT — opsional) =====
# Dipakai bila proxy Vercel tidak tersedia (mis. npm run dev).
# ⚠️ JANGAN SET DI DASHBOARD VERCEL: VITE_* ter-bundle ke JS client saat
#    production build. Kode sudah mem-gate via import.meta.env.DEV sehingga
#    cabang ini dibuang saat production build — memastikan token TIDAK pernah
#    masuk dist/. Gunakan fine-grained PAT read-only (Public repositories).
VITE_GITHUB_TOKEN=ghp_placeholder_isi_buat_local